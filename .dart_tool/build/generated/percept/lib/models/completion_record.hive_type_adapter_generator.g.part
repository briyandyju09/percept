// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class CompletionRecordAdapter extends TypeAdapter<CompletionRecord> {
  @override
  final typeId = 3;

  @override
  CompletionRecord read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return CompletionRecord(
      id: fields[0] as String,
      contentId: fields[1] as String,
      contentType: fields[2] as String,
      completedAt: fields[3] as DateTime,
      resultSummary: fields[4] as String?,
    );
  }

  @override
  void write(BinaryWriter writer, CompletionRecord obj) {
    writer
      ..writeByte(5)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.contentId)
      ..writeByte(2)
      ..write(obj.contentType)
      ..writeByte(3)
      ..write(obj.completedAt)
      ..writeByte(4)
      ..write(obj.resultSummary);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is CompletionRecordAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}

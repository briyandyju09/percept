// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class DimensionScoresAdapter extends TypeAdapter<DimensionScores> {
  @override
  final typeId = 0;

  @override
  DimensionScores read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return DimensionScores(
      observation: fields[0] == null ? 50 : (fields[0] as num).toInt(),
      memory: fields[1] == null ? 50 : (fields[1] as num).toInt(),
      socialIntelligence: fields[2] == null ? 50 : (fields[2] as num).toInt(),
      composure: fields[3] == null ? 50 : (fields[3] as num).toInt(),
      communication: fields[4] == null ? 50 : (fields[4] as num).toInt(),
      reasoning: fields[5] == null ? 50 : (fields[5] as num).toInt(),
      performance: fields[6] == null ? 50 : (fields[6] as num).toInt(),
    );
  }

  @override
  void write(BinaryWriter writer, DimensionScores obj) {
    writer
      ..writeByte(7)
      ..writeByte(0)
      ..write(obj.observation)
      ..writeByte(1)
      ..write(obj.memory)
      ..writeByte(2)
      ..write(obj.socialIntelligence)
      ..writeByte(3)
      ..write(obj.composure)
      ..writeByte(4)
      ..write(obj.communication)
      ..writeByte(5)
      ..write(obj.reasoning)
      ..writeByte(6)
      ..write(obj.performance);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is DimensionScoresAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
